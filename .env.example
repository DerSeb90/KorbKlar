# Host-Port des Docker-Dienstes. Intern bleibt der Container auf Port 8000.
SUPERMARKT_PORT=8000

# Optionaler Schutz nur für POST /api/v1/compare.
SUPERMARKT_API_KEY=

# Laufzeitdaten. Für Docker passen die Standardwerte zum Volume /data.
SUPERMARKT_DATA_DIR=/data
SUPERMARKT_CACHE_DB=/data/supermarkt-cache.sqlite3
SUPERMARKT_SIGNING_SECRET_FILE=/data/.signing-secret
# Leer lassen, damit beim ersten Start automatisch ein persistenter Schlüssel erzeugt wird.
SUPERMARKT_SIGNING_SECRET=
SUPERMARKT_IMAGE_CACHE_DIR=/data/supermarkt-images
SUPERMARKT_KAUFLAND_CACHE_DIR=/data/kaufland
SUPERMARKT_REWE_CACHE_DIR=/data/rewe

# Angebots-Snapshot-Cache.
SUPERMARKT_CACHE_TTL_MINUTES=30
SUPERMARKT_CACHE_MAX_SNAPSHOTS=100
SUPERMARKT_RESULT_RETENTION_HOURS=168

# Netzwerk und Parallelität.
SUPERMARKT_TIMEOUT_SECONDS=25
SUPERMARKT_MARKTGURU_PAGE_SIZE=500
SUPERMARKT_MAX_WORKERS=8
# Leer verwendet automatisch korb-klar/<Version>.
SUPERMARKT_USER_AGENT=

# Filialzuordnungen. Die Angebotsdaten selbst bleiben frisch.
SUPERMARKT_KAUFLAND_STORE_CACHE_TTL_SECONDS=86400
SUPERMARKT_REWE_STORE_CACHE_TTL_SECONDS=86400

# Bildcache.
SUPERMARKT_IMAGE_CACHE_TTL_SECONDS=604800
SUPERMARKT_IMAGE_CACHE_MAX_BYTES=536870912
SUPERMARKT_IMAGE_MAX_FILE_BYTES=4194304

# Einkaufsliste über KitchenOwl. Leer lassen, um die Funktion abzuschalten.
# Im mitgelieferten Stack geht KorbKlar ueber den Web-Container: das Backend
# spricht das uwsgi-Protokoll, kein HTTP.
SUPERMARKT_KITCHENOWL_URL=http://kitchenowl-web
# Long-lived Token aus KitchenOwl: Profil, Sitzungen, Long-lived Tokens.
SUPERMARKT_KITCHENOWL_TOKEN=
# Vorausgewählte Listen-ID. Leer lassen, um die Liste in der Oberfläche zu wählen.
SUPERMARKT_KITCHENOWL_LIST_ID=
# Nur auf 0 setzen, wenn KitchenOwl ein selbstsigniertes Zertifikat nutzt.
SUPERMARKT_KITCHENOWL_VERIFY_TLS=1
SUPERMARKT_KITCHENOWL_TIMEOUT_SECONDS=15
SUPERMARKT_KITCHENOWL_MAX_ITEMS=50
# Angebote auf einen bereits vorhandenen KitchenOwl-Artikel legen, statt fuer
# jeden Angebotsnamen einen neuen anzulegen. Der volle Name bleibt in der Notiz.
SUPERMARKT_KITCHENOWL_MATCH_ITEMS=1
# Haendler als Kategorie fuehren, damit die Liste nach Markt gruppiert. Achtung:
# die Kategorie haengt am Artikel, nicht am Listeneintrag — ein Artikel wandert
# also mit, sobald ein anderer Markt ihn guenstiger anbietet.
SUPERMARKT_KITCHENOWL_RETAILER_CATEGORIES=1
# KitchenOwl-Kategorien haben nur einen Namen und kein Bildfeld; ein Icon geht
# deshalb nur als Emoji davor. Leer laesst den Namen unveraendert.
SUPERMARKT_KITCHENOWL_CATEGORY_PREFIX=🛒 

# KitchenOwl selbst, gestartet mit dem Profil "proxy".
# Pflicht, mindestens 32 Zeichen: openssl rand -base64 48
# KitchenOwl selbst prueft das nicht und liefe sonst mit leerem Schluessel.
KITCHENOWL_JWT_SECRET=
# Öffentliche Adresse der KitchenOwl-Oberfläche, für korrekte Links.
KITCHENOWL_PUBLIC_URL=

# Zugriffskontrolle für öffentlich erreichbare Instanzen.
# Ist SUPERMARKT_API_KEY gesetzt, braucht jede Route außer /health entweder
# diesen Bearer-Token oder eine Quell-IP aus SUPERMARKT_TRUSTED_NETWORKS.
# Damit bleibt die Oberfläche im VPN ohne Login nutzbar, während App und
# Skripte sich von überall mit dem Token ausweisen.
# Komma-getrennte CIDRs, z. B. 10.8.0.0/24,192.168.30.0/24.
SUPERMARKT_TRUSTED_NETWORKS=
# Nur Reverse Proxies, deren X-Forwarded-For geglaubt werden darf. Leer
# lassen heißt: der Header wird komplett ignoriert.
# WICHTIG: uvicorn muss mit --no-proxy-headers laufen, sonst überschreibt es
# die Client-Adresse selbst und diese Einstellung wird wirkungslos.
SUPERMARKT_TRUSTED_PROXIES=

# Chromium-kompatibler Browser für den Kaufland-Adapter. Leer sucht die
# üblichen Namen und Installationspfade.
SUPERMARKT_CHROMIUM_BINARY=

# Reverse Proxy (Profil "proxy"). Caddy holt und erneuert die Let's-Encrypt-
# Zertifikate selbst. Beide Werte sind Pflicht, sobald das Profil startet.
KORBKLAR_DOMAIN=
KORBKLAR_ACME_EMAIL=
# Zweite Subdomain, auf der Caddy KitchenOwl bedient.
KORBKLAR_KITCHENOWL_DOMAIN=

# Eigenes Image, damit ein Fork sein eigenes Build deployen kann.
KORBKLAR_IMAGE=ghcr.io/lesecuritae/korbklar:latest
# Schnittstelle, auf der Port 8000 veröffentlicht wird. Hinter dem Proxy die
# VPN-Adresse eintragen, damit die Oberfläche nicht öffentlich hängt.
KORBKLAR_BIND_ADDRESS=0.0.0.0
# Subnetz des Compose-Netzes; muss zu SUPERMARKT_TRUSTED_PROXIES passen.
KORBKLAR_SUBNET=172.28.0.0/24
# Onboarding schliesst sich selbst, sobald das erste Konto existiert. Auf true
# setzen, nachdem du deins angelegt hast: dann bleibt es auch bei geleertem
# Datenvolume zu. Die Registrierung ist ohnehin aus (OPEN_REGISTRATION=false).
KITCHENOWL_DISABLE_ONBOARDING=false
